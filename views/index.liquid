{% render 'partials/header.liquid', title: 'mijn progressie' %}
    <main>
        <div class="main-score">
            <p>whs</p>
            <p>{{ golfer.handicap | round: 1}}</p>
            <p>{{ golfer.improvement | round: 1}}</p>
            <p> 
                was {{ golfer.previous_handicap | round: 1}} op
                {{ golfer.previous_date | date: "%d %b %y" }}
             &#183; low {{ golfer.low | round: 1}}
            </p>
        </div>
        <section>
            <p class="section-name">log</p>
            <h2 class="section-title">
                Recente rondes
            </h2>
            <article>
                <h3>
                    Recente rondes
                </h3>
                <p>5 rondes</p>
                <button popovertarget="add-score" class="primary-button"> score toevoegen </button>
                <ul>
                {% for score in scores %}
                <li>
                    <p class="round-date">{{ score.date | date: "%d %b %y" }}</p>
                    <p class="round-course">{{ score.course }}</p>
                    <p class="round-type">{{ score.type }}</p>
                    <p class="round-score">{{ score.differential | round: 1 }}</p>
                    <form method="post" action="/score-verwijderen">
                        <input type="hidden" name="score_id" value="{{ score.id }}">
                        <button class="primary-button delete"><img src="assests/trash.svg" alt="verwijderen" width="20" height="20"></button>
                    </form>
                </li>
                {% endfor %}
                </ul>
            </article>
        </section>
        <form method="POST" action="/score-toevoegen" popover id="add-score">
            <input type="hidden" name="golfer_id" value="{{ golfer.id }}">
            <label>
                Datum:
                <input type="date" name="date" value="{{ 'today' | date: '%Y-%m-%d' }}">
            </label>
            <label>
                Baan:
                <input type="text" name="course">
            </label>
            <label>
                Score
                <input type="number" name="score">
            </label>
            <label>
                <input type="checkbox" checked name="type" value="QUAL">
                Telt mee voor handicap
            </label>
            <button class="primary-button">versturen</button>
        </form>
        {% comment %} <section>
            <p>volgende handicap section</p>
        </section>
        <section>
            <p>ranking section</p>
            {% for ranking in rankings %}
                {{ranking.category}}
                {{ ranking.rankings }}
            {% endfor %}
        </section>
        <section>
            <p>mijlpalen section</p>
            {% for milestone in milestones %}
                {{milestone.title}}
            {% endfor %}
        </section> {% endcomment %}
    </main>
</body>
</html>
{% render 'partials/header.liquid', title: 'mijn score' %}
    <main>
        <section class="main-score">
            <p>whs</p>
            <h1>{{ golfer.handicap | round: 1}}</h1>
            <p>{{ golfer.improvement | round: 1}}</p>
            <p> 
                was {{ golfer.previous_handicap | round: 1}} op
                {{ golfer.previous_date | date: "%d %b %y" }}
             &#183; low {{ golfer.low | round: 1}}
            </p>
        </section>
        <section>
            <p>verloop</p>
            <h2>
                Hoe staa je ervoor?
            </h2>
            <img src="assests/grafiek.png" width="200" height="100" alt="grafiek">
        </section>
        <section>
            <p>log</p>
            <h2>
                Recente rondes
            </h2>
            <p>5 rondes</p>
            <article>
                <h3>
                    Recente rondes
                </h3>
                <ul>
                {% for score in scores %}
                <li>
                    {{ score.date | date: "%d %b %y" }}
                    {{ score.course }}
                    {{ score.type }}
                    {{ score.differential | round: 1 }}
                </li>
                {% endfor %}
                </ul>
            </article>
        </section>
        <form>
            <input type="date" name="date">
            <input type="text" name="course">
            <input type="number" name="score">
            <input type="checkbox" name="">
        </form>
        {% comment %} <section>
            <p>volgende handicap section</p>
        </section>
        <section>
            <p>ranking section</p>
            {% for ranking in rankings %}
                {{ranking.category}}
                {{ ranking.rankings }}
            {% endfor %}
        </section>
        <section>
            <p>mijlpalen section</p>
            {% for milestone in milestones %}
                {{milestone.title}}
            {% endfor %}
        </section> {% endcomment %}
    </main>
</body>
</html>